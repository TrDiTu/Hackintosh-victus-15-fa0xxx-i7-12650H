+static void xeCurPublish(thread_call_param_t, thread_call_param_t) {
+	auto *svc = OSDynamicCast(IOService, reinterpret_cast<OSObject *>(gTopoAcc));
+	if (!svc || !NGreen::callback) return;
+	static const uint32_t regs[] = {0x70080, 0x70084, 0x70088, 0x700a0, 0x700ac};
+	static const char *const names[] = {"xe-cur-ctl", "xe-cur-base", "xe-cur-pos", "xe-cur-fbcctl", "xe-cur-surflive"};
+	for (size_t i = 0; i < arrsize(regs); i++) svc->setProperty(names[i], NGreen::callback->readReg32(regs[i]), 32);
+	svc->setProperty("xe-cur-img-w", gXeCurW, 32);
+	svc->setProperty("xe-cur-img-h", gXeCurH, 32);
+	svc->setProperty("xe-cur-ret", gXeCurRet, 32);
+	svc->setProperty("xe-cur-n", gXeCurN, 32);
+
+	// xe/curdiag2: compare what the CPU wrote (Apple's dst = ctl+0xc98 + (gaddr - ctl+0xdc0), as in hwSetCursorImage)
+	// with what the display reads (BAR2 aperture at the cursor's GGTT address), row by row, plus the 4 GGTT PTEs.
+	auto *ctl = static_cast<uint8_t *>(gXeCurCtl);
+	auto *fb = static_cast<uint8_t *>(gXeCurFb);
+	auto *cb = NGreen::callback;
+	if (ctl && fb) {
+		uint32_t idx = *reinterpret_cast<volatile uint32_t *>(fb + 0x4ad8) & 1;
+		uint32_t gaddr = *reinterpret_cast<volatile uint32_t *>(fb + 0x1f4 + idx * 4);
+		uint32_t stolenOff = *reinterpret_cast<volatile uint32_t *>(ctl + 0xdc0);
+		auto *cpuBase = *reinterpret_cast<uint8_t *volatile *>(ctl + 0xc98);
+		svc->setProperty("xe-cur-gaddr", gaddr, 32);
+		svc->setProperty("xe-cur-idx", idx, 32);
+		svc->setProperty("xe-cur-stolenoff", stolenOff, 32);
+		for (uint32_t p = 0; p < 4; p++) {
+			char k[16];
+			snprintf(k, sizeof(k), "xe-cur-pte%u", p);
+			svc->setProperty(k, ((uint64_t)cb->readReg32(GGTT_PTE_LO((gaddr >> 12) + p) + 4) << 32) | cb->readReg32(GGTT_PTE_LO((gaddr >> 12) + p)), 64);
+		}
+		const uint32_t bytes = 64 * 64 * 4;
+		volatile uint32_t *cpu = (cpuBase && gaddr >= stolenOff && (gaddr - stolenOff) + bytes <= 0x200000U) ? reinterpret_cast<volatile uint32_t *>(cpuBase + ((gaddr - stolenOff) & ~3U)) : nullptr;
+		volatile uint32_t *gpu = (cb->xeAperturePtr() && gaddr + bytes <= cb->xeApertureLen()) ? cb->xeAperturePtr() + gaddr / 4 : nullptr;
+		uint64_t rowsCpu = 0, rowsGpu = 0;
+		uint32_t diff = 0;
+		for (uint32_t r = 0; r < 64; r++) {
+			for (uint32_t x = 0; x < 64; x++) {
+				uint32_t c = cpu ? cpu[r * 64 + x] : 0, g = gpu ? gpu[r * 64 + x] : 0;
+				if (c >> 24) rowsCpu |= 1ULL << r;
+				if (g >> 24) rowsGpu |= 1ULL << r;
+				if (cpu && gpu && c != g) diff++;
+			}
+		}
+		svc->setProperty("xe-cur-rows-cpu", rowsCpu, 64);
+		svc->setProperty("xe-cur-rows-gpu", rowsGpu, 64);
+		svc->setProperty("xe-cur-diff", cpu && gpu ? diff : 0xFFFFFFFFU, 32);
+
+		// xe/curdiag3: the CPU writes the cursor through the BAR2 aperture (ctl+0xc98 = map of withSubRange(ctl+0xc80,
+		// ctl+0xdc0, ctl+0xdc8)), so a tiling fence over that range would detile CPU writes while the display reads raw
+		// memory. Publish every valid fence, the one covering the cursor, the FB's post-stolen window and the
+		// accelerator's GPU VA segment start (GMSFIX makes it 60 MB, the same place the FB window starts).
+		svc->setProperty("xe-cur-fbwin", *reinterpret_cast<volatile uint32_t *>(ctl + 0xdc8), 32);
+		uint32_t fenceHit = 0xFF, fenceValid = 0;
+		for (uint32_t i = 0; i < 32; i++) {
+			uint32_t lo = cb->readReg32(0x100000 + i * 8), hi = cb->readReg32(0x100000 + i * 8 + 4);
+			if (!(lo & 1)) continue;
+			fenceValid++;
+			char k[24];
+			snprintf(k, sizeof(k), "xe-fence%02u", i);
+			svc->setProperty(k, ((uint64_t)hi << 32) | lo, 64);
+			uint32_t start = lo & 0xFFFFF000U, end = hi & 0xFFFFF000U;
+			if (gaddr >= start && gaddr <= end + 0xFFFU && fenceHit == 0xFF) fenceHit = i;
+		}
+		svc->setProperty("xe-fence-valid", fenceValid, 32);
+		svc->setProperty("xe-fence-hit", fenceHit, 32);
+		svc->setProperty("xe-fencefix-n", gXeFenceFixN, 32);
+		svc->setProperty("xe-fencefix-end", gXeFenceFixLast, 32);
+	}
+	{
+		auto *acc = static_cast<uint8_t *>(gTopoAcc);
+		auto *mm = acc ? *reinterpret_cast<uint8_t *volatile *>(acc + 0x1260) : nullptr;
+		if (acc) svc->setProperty("xe-acc-fbreg", (uint32_t)*reinterpret_cast<volatile uint8_t *>(acc + 0x128c), 32);
+		if (mm) {
+			svc->setProperty("xe-mm-seg", *reinterpret_cast<volatile uint64_t *>(mm + 0xa8), 64);
+			svc->setProperty("xe-mm-rangestart", *reinterpret_cast<volatile uint64_t *>(mm + 0xb0), 64);
+			svc->setProperty("xe-mm-rangesize", *reinterpret_cast<volatile uint64_t *>(mm + 0xb8), 64);
+			svc->setProperty("xe-mm-stolen30", *reinterpret_cast<volatile uint64_t *>(mm + 0x30), 64);
+			svc->setProperty("xe-mm-stolen38", *reinterpret_cast<volatile uint64_t *>(mm + 0x38), 64);
+		}
+	}
+}
+static IOReturn xeHwSetCursorImage(void *that, void *fb, void *info) {
+	IOReturn r = FunctionCast(xeHwSetCursorImage, gOrgHwSetCursorImage)(that, fb, info);
+	gXeCurN++;
+	gXeCurCtl = that;
+	gXeCurFb = fb;
+	if (info) {  // IOHardwareCursorInfo: u16 major, u16 minor, u32 cursorHeight, u32 cursorWidth, ...
+		gXeCurH = *reinterpret_cast<const UInt32 *>(static_cast<const uint8_t *>(info) + 4);
+		gXeCurW = *reinterpret_cast<const UInt32 *>(static_cast<const uint8_t *>(info) + 8);
+	}
+	gXeCurRet = static_cast<uint32_t>(r);
+	if (!gXeCurTc) gXeCurTc = thread_call_allocate(xeCurPublish, nullptr);
+	if (gXeCurTc) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(200, kMillisecondScale, &deadline);
+		thread_call_enter_delayed(gXeCurTc, deadline);
+	}
+	return r;
+}
